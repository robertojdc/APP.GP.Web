@{
    Layout = @"~/Views/Shared/_LayoutInvite.cshtml";
}

<div class="bg2-wrapper" data-aos="fade-up">
    <div class="formulario" style="background-color:#79211F; opacity:0.9; padding: 10px; color: #FFF; max-width:400px; margin:auto;">
        <h2 class="display-4" style="text-align:center; font-weight:500;">Confirmación</h2>
        <div class="form-group">
            <label>Nombre(s)</label>
            <input type="text" id="nombre" class="form-control" placeholder="Nombre" />
        </div>
        <div class="form-group">
            <label>Primer apellido</label>
            <input type="text" id="apellidoPaterno" class="form-control" placeholder="Apellido paterno" />
        </div>
        <div class="form-group">
            <label>Segundo apellido</label>
            <input type="text" id="apellidoMaterno" class="form-control" placeholder="Apellido materno" />
        </div>
        <div class="form-group">
            <label>Cargo / Puesto</label>
            <input type="text" id="cargo" class="form-control" placeholder="Cargo / Puesto" />
        </div>
        <div class="form-group">
            <label>Correo electrónico</label>
            <input type="email" id="correoElectronico" class="form-control" placeholder="Correo electrónico" />
        </div>
        <div class="form-group">
            <label>Teléfono (WhatsApp)</label>
            <input type="text" id="telefonoPersonal" class="form-control" placeholder="Teléfono" />
        </div>
        <div class="form-group" style="text-align:right;">
            <br />
            <button id="confirmProtesta" class="btn btn-danger me-2"><i class="fa fa-check"></i>&nbsp;Enviar</button>
        </div>
    </div>
</div>

