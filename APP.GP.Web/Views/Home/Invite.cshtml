@{
    Layout = @"~/Views/Shared/_LayoutInvite.cshtml";
}
<div class="bg1-wrapper" data-aos="fade-up">
    <div class="text-center" data-aos="fade-up">
        <img src="~/img/invite/armentaGob.png" style="width:380px; height: 260px;" />
    </div>
    <div class="container">
        <div class="texto-superpuesto text-center" data-aos="fade-up">
            <h2 class="display-4"><b>Estamos a</b></h2>
        </div>
        <div class="countdown">
            <div class="time-box">
                <span id="days">0</span>
                <label>Días</label>
            </div>
            <div class="time-box">
                <span id="hours">0</span>
                <label>Horas</label>
            </div>
            <div class="time-box">
                <span id="minutes">0</span>
                <label>Minutos</label>
            </div>
            <div class="time-box">
                <span id="seconds">0</span>
                <label>Segundos</label>
            </div>
        </div>
        <div class="hero">
            <div class="texto-superpuesto text-center" data-aos="fade-up">
                <h2 class="display-4"><b>para la</b></h2>
                <h1 class="display-4"><b>Toma de Protesta</b></h1>
            </div>
        </div>
    </div>
</div>