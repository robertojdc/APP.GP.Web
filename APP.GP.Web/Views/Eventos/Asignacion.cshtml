<link href="~/lib/dataTables/datatables.min.css" rel="stylesheet">

<script src="~/lib/dataTables/datatables.min.js"></script>

<div class="container-fluid py-4">
    <div class="card shadow-sm mb-4">
        <div class="card-header text-white text-center">
            <h3 class="mb-0">ADMINISTRACIÓN DE EVENTOS</h3>
        </div>
        <div class="card-body">
            <form id="clasificacionForm" class="row g-3">
                <div class="col-md-4">
                    <label for="ddlGrupo" class="form-label">EVENTO</label>
                    <input id="ddlGrupo" class="form-control" placeholder="Seleccione un grupo">
                </div>
                <div class="col-md-4">
                    <label for="subgrupo" class="form-label">ESCENARIO</label>
                    <input id="subgrupo" name="subgrupo" class="form-control" placeholder="Seleccione un subgrupo">
                </div>
                <div class="col-md-4" id="btnDescargar" style="display:none; margin-top:48px;text-align:right;">
                    <button type="button" class="btn btn-success" onclick="descargarReporteExcel(event)"><span style="margin-top:-3px;" class="k-icon k-font-icon k-i-excel k-icon-32"></span>&nbsp;Descargar</button>
                    <button type="button" class="btn btn-success" onclick="obtenerInvitados()">Descargar invitaciones</button>
                </div>
                <input type="hidden" id="hidEvento" />
                <input type="hidden" id="hidEscenario" />
                <input type="hidden" id="hidFechaHora" />
            </form>
        </div>
    </div>
</div>

<input type="hidden" id="idSelected" />

<div id="divEscenario_1"></div>
<div id="divEscenario_2"></div>
<hr />
<div id="windowInstitucional" style="border: 2px solid #8B0000; padding: 20px; background-color: #FFFFFF; display:none; min-height:500px;">
    <label id="lblUbicacion" style="font-size:14pt;"></label>
    <table id="grid" class="display" style="width:100%;">
        <thead>
            <tr>
                <th>Nombre Completo</th>
                <th>Descripción</th>
                <th>Lugar Asignado</th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>
<script type="text/x-kendo-template" id="template">
    <div class="actor" onclick="asignarActor(#= idActor #)">
        <h2>#: cargoActual #</h2>
        <h3>#: nombre # #: apellidoPaterno # #: apellidoMaterno #</h3>
    </div>
</script>
<script id="templateTooltip" type="text/x-kendo-template">
    <div class="template-wrapper">
        <p>#=target.data('actor-id')#</p>
    </div>
</script>
<div id="detalleActorWindow"></div>
<div id="boletoModal" style="display:none;">
    <div id="boletoContent">
        <input type="hidden" id="hidIdInvitacion" />

        <div id="divInfo" style="text-align:center; font-size:14pt;">
            <label id="lblActor" style="font-weight:700; font-size:14pt;"></label><br /><br /><br />
            <div id="lblUbicacionEsc"> Fila:&nbsp;<b><label id="lblFila"></label></b>&nbsp;&nbsp;&nbsp;Asiento:&nbsp;<b><label id="lblAsiento"></label></b></div>

        </div>
        <div id="divPrensa" style="text-align:center;color: #000;"><label id="lblCArgoActual"></label></div>
        <div id="qrCode" class="qr-container" style="margin-top:45px;"></div>
    </div>
    <div class="row mb-3 buttons-container">
        <input type="button" id="exportarPDF" class="btn pdf-button styled-button" value="Descargar" />
        <input type="button" class="btn whatsapp-button styled-button" value="WhatsApp" onclick="enviarWhats()" />
        <input type="button" class="btn email-button styled-button" value="Correo" onclick="enviarCorreo()" />
    </div>
</div>
<input id="previewImage" type="hidden" />
<script>
    var allActors = [];

    function renderizarDisposiciones(disposiciones) {
        $("#btnDescargar").show();
        $('div[data-fila][data-columna]').each(function () {
            $(this).css({
                "background-image": "",
                "background-size": "",
                "background-position": "",
                "background-repeat": ""
            });
            $(this).removeAttr('data-actor-id');
        });
        disposiciones.forEach(function (disposicion) {
            var fila = disposicion.fila;
            var columna = disposicion.columna;
            var idActor = disposicion.idActor;
            var fotoBase64 = disposicion.fotoBase64;

            var $cuadro = $('div[data-fila="' + fila + '"][data-columna="' + columna + '"]');

            if ($cuadro.length && idActor && fotoBase64) {
                $cuadro.css({
                    "background-image": "url('data:image/jpeg;base64," + fotoBase64 + "')",
                    "background-size": "cover",
                    "background-position": "center",
                    "background-repeat": "no-repeat"
                });
                $cuadro.attr('data-actor-id', idActor);
            } else if (idActor) {
                $cuadro.css({
                    "background-color": "#CCC",
                    "background-size": "cover",
                    "background-position": "center",
                    "background-repeat": "no-repeat"
                });
                $cuadro.attr('data-actor-id', idActor);
                $cuadro.kendoTooltip({
                    //content: kendo.template($("#templateTooltip").html()), // disposicion.nombreActor + ' ' + disposicion.apellidoPaterno + ' ' + disposicion.apellidoMaterno,
                    content: disposicion.nombreActor + ' ' + disposicion.apellidoPaterno + ' ' + disposicion.apellidoMaterno + '<br/>Lugar asignado: ' + fila + ' - ' + columna,
                    position: "top",
                    animation: {
                        open: {
                            effects: "zoom",
                            duration: 50
                        }
                    }
                });
                $cuadro.html(obtenerIniciales(disposicion.nombre, disposicion.apellidoPaterno, disposicion.apellidoMaterno));
            }
        });
    }

    function obtenerDatosEscenariosById() {
        $.ajax({
            url: '/Eventos/GetEscenarioById',
            type: 'GET',
            data: { idEscenario: $("#subgrupo").val() },
            success: function (response) {
                $("#hidEvento").val(response.evento.nombreEvento);
                $("#hidEscenario").val(response.nombreEscenario);
                $("#hidFechaHora").val(response.evento.fechaEvento);
            },
            error: function (xhr, status, error) {
                console.log('Ocurrió un error: ' + error);
            }
        });
    }

    function obtenerDisposicionesEscenario(idEscenario) {
        obtenerDatosEscenariosById();
        $.ajax({
            url: '/Eventos/GetDisposicionesForEscenario',
            type: 'POST',
            data: { idEvento: $("#ddlGrupo").val(), idEscenario: idEscenario },
            success: function (data) {
                renderizarDisposiciones(data);
            },
            error: function (error) {
                console.error('Error al cargar las disposiciones:', error);
            }
        });
    }

    function obtenerEscenarios() {
        $.ajax({
            url: '/Eventos/GetEscenariosByEvento',
            type: 'GET',
            data: { idEvento: $("#ddlGrupo").val() },
            success: function (response) {
                $("#subgrupo").kendoDropDownList({
                    dataTextField: "nombreEscenario",
                    dataValueField: "idEscenario",
                    dataSource: response,
                    optionLabel: "Seleccione un escenario",
                    change: function (e) {
                        var idEscenario = this.value();
                        if (idEscenario == 4) {
                            $("#divEscenario_1").show();
                            $("#divEscenario_2").hide();
                            $('#divEscenario_1').load('/escenarios/estrella.html?' + new Date().getTime(), function () {
                                obtenerDisposicionesEscenario(idEscenario);
                            });
                        }
                        else if (idEscenario == 5) {
                            $("#divEscenario_1").hide();
                            $("#divEscenario_2").show();
                            $('#divEscenario_2').load('/escenarios/coctel.html?' + new Date().getTime(), function () {
                                obtenerDisposicionesEscenario(idEscenario);
                            });
                        } else if (idEscenario == 6 || idEscenario == 7) {
                            $("#divEscenario_1").hide();
                            $("#divEscenario_2").show();
                            $('#divEscenario_2').load('/escenarios/prensa.html?' + new Date().getTime(), function () {
                                obtenerDisposicionesEscenario(idEscenario);
                            });
                        }
                    }
                });
            },
            error: function (xhr, status, error) {
                console.log('Ocurrió un error: ' + error);
            }
        });
    }

    function obtenerEventos() {
        $("#btnDescargar").hide();
        $.ajax({
            url: '/Eventos/GetEventos',
            type: 'GET',
            success: function (response) {
                $("#ddlGrupo").kendoDropDownList({
                    dataTextField: "nombreEvento",
                    dataValueField: "idEvento",
                    dataSource: response,
                    optionLabel: "Seleccione un evento",
                    change: function (e) {
                        var idGrupo = this.value();
                        obtenerEscenarios(idGrupo);
                    }
                });
            },
            error: function (xhr, status, error) {
                console.log('Ocurrió un error: ' + error);
            }
        });
    }

    function gridActores(dataSource) {
        const transformedData = dataSource.map(item => ({
            idActor: item.idActor,
            nombreCompleto: `${item.nombre || ''} ${item.apellidoPaterno || ''} ${item.apellidoMaterno || ''}`.trim(),
            descripcion: item.cargoActual || '',
            lugarAsignado: (item.fila && item.columna) ? `Fila: ${item.fila} - Asiento: ${item.columna}` : ' - '
        }));

        if ($.fn.DataTable.isDataTable('#grid')) {
            $('#grid').DataTable().destroy();
        }

        $('#grid').DataTable({
            data: transformedData,
            columns: [
                { data: 'nombreCompleto', title: 'Nombre', width: '35%' },
                { data: 'descripcion', title: 'Descripción', width: '30%' },
                { data: 'lugarAsignado', title: 'Lugar asignado', width: '25%' },
                {
                    title: 'Asignar',
                    width: '10%',
                    render: function (data, type, row) {
                        if (row.lugarAsignado == ' - ')
                            return `<center><button class="btn btn-success btn-sm" onclick="asignarActor(${row.idActor})"><span class="k-icon k-font-icon k-i-check k-icon-24"></span></button></center>`;
                        else
                            return '';
                    }
                }
            ],
            paging: true,
            searching: true,
            ordering: true,
            pageLength: 10,
            lengthChange: false,
            autoWidth: false,
            fixedColumns: true
        });
    }

    function obtenerAllActores() {
        var fila = obtenerFilaSeleccionada();
        var columna = obtenerColumnaSeleccionada();
        $("#lblUbicacion").text(`Ubicación: Fila ${fila} - Asiento ${columna}`);
        if (allActors.length == 0) {
            $.ajax({
                url: '/Eventos/GetActoresEscenariosById',
                type: 'GET',
                data: { idEscenario: $("#subgrupo").val() },
                dataType: 'json',
                success: function (data) {
                    gridActores(data);
                },
                error: function (xhr, status, error) {
                    console.error('Error al obtener los actores:', error);
                }
            });
        }
    }

    function asignarActor(idActor) {
        var idDisposicion = $("#idSelected").val();
        var fila = obtenerFilaSeleccionada();
        var columna = obtenerColumnaSeleccionada();

        $.ajax({
            url: '/Eventos/AddDisposicion',
            type: 'POST',
            data: {
                IdActor: idActor,
                IdEscenario: $("#subgrupo").val(),
                IdDisposicion: idDisposicion,
                Fila: fila,
                Columna: columna
            },
            beforeSend: function () {
                mostrarLoading();
            },
            success: function (result) {
                if (result.procesoExitoso > 0) {
                    MensajeExito("Éxito", "Lugar asignado satisfactoriamente");
                    $("#subgrupo").data("kendoDropDownList").trigger("change");
                    $("#windowInstitucional").data("kendoWindow").close();
                    $("#detalleActorWindow").data("kendoWindow").close();
                } else {
                    MensajeExito("Error", "Error al asignar el lugar: " + result.mensaje);
                }
            },
            complete: function () {
                ocultarLoading();
            },
            error: function (error) {
                console.error('Error al asignar el actor:', error);
            }
        });
    }

    function ModificarAsignacion(idActor) {
        mostrarVentanaKendo("#windowInstitucional", "950px", "Búsqueda de invitados", null);
    }

    function mostrarVentanaKendo(selector, ancho, titulo, id) {
        if (id) {
            verDetalleAsignacion(id);
        } else {
            var $kendoWindow = $(selector).kendoWindow({
                width: ancho,
                title: titulo,
                visible: false,
                modal: true,
                actions: ["Close"],
            }).data("kendoWindow");
            $kendoWindow.center().open();
            obtenerAllActores();
        }
    }

    function verDetalleAsignacion(idActor) {
        $.ajax({
            url: '/Eventos/GetDetalleAsignacion',
            type: 'POST',
            data: {
                idActor: idActor,
                idEscenario: $("#subgrupo").val()
            },
            success: function (actor) {
                const detalleActorWindow = $("#detalleActorWindow").data("kendoWindow");

                if (!detalleActorWindow) {
                    $("#detalleActorWindow").kendoWindow({
                        width: "700px",
                        title: "Detalle de la asignación",
                        modal: true,
                        visible: false,
                        actions: ["Close"]
                    });
                }
                const windowInstance = $("#detalleActorWindow").data("kendoWindow");

                const contenido = `
                                                                            <div class="container p-4 border rounded bg-light shadow-sm">
                                                                                <div class="row mb-4">
                                                                                    <div class="col-12 col-md-8 d-flex align-items-center">
                                                                                        <div>
                                                                                            <h3 class="fw-bold">${actor.nombreActor} ${actor.apellidoPaterno} ${actor.apellidoMaterno}</h3>

                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                                <div class="row mb-3" style="font-size:14pt;">
                                                                                    <div class="col-4 d-flex align-items-center">
                                                                                        <label>Sección:</label>&nbsp;&nbsp;<label class="fw-bold">GENERAL</label>
                                                                                    </div>
                                                                                    <div class="col-4 d-flex align-items-center">
                                                                                        <label>Fila:</label>&nbsp;&nbsp;<label class="fw-bold">${actor.fila}</label>
                                                                                    </div>
                                                                                    <div class="col-4 d-flex align-items-center">
                                                                                        <label>Asiento:</label>&nbsp;&nbsp;<label class="fw-bold">${actor.columna}</label>
                                                                                    </div>
                                                                                </div>
                                                                                <br/>
                                                                                <div class="row">
                                                                                    <div class="col-2">  </div>
                                                                                    <div class="col-4">
                                                                                        <input type="button" class="btn btn-outline-secondary" onclick="GenerarInvitacion(${actor.idActor},${actor.idDisposicion})" value="Generar invitación" id="btnInvite" />
                                                                                    </div>
                                                                                    <div class="col-4">
                                                                                        <input type="button" class="btn btn-danger me-2" onclick="ModificarAsignacion(${actor.idActor})" value="Modificar Asignación" id="btnInvite" />
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        `;
                windowInstance.content(contenido);
                windowInstance.center().open();
            },
            error: function (xhr, status, error) {
                console.error('Error al obtener los detalles del actor:', error);
            }
        });
    }

    function obtenerInvitados() {
        obtenerDatosEscenariosById();
        $.ajax({
            url: '/Eventos/GetDisposicionesForEscenario',
            type: 'POST',
            data: { idEvento: $("#ddlGrupo").val(), idEscenario: $("#subgrupo").val() },
            success: function (data) {
                const idActors = data.map(item => item.idActor);
                invitacionesAutomaticas(idActors);
            },
            error: function (error) {
                console.error('Error al cargar las disposiciones:', error);
            }
        });
    }

    async function invitacionesAutomaticas(idsUsuario) {

        for (const idUsuario of idsUsuario) {
            try {
                await GenerarInvitacionTest(idUsuario, $("#subgrupo").val());
                await delay(1000); // Espera de 4 segundos
            } catch (error) {
                console.error(`Error procesando el usuario ${idUsuario}:`, error);
            }
        }
        console.log("Todas las invitaciones han sido generadas.");
    };

    function delay(ms) {
        return new Promise(resolve => setTimeout(resolve, ms));
    }

    function GenerarInvitacionTest(idActor, idDisposicion) {
        return new Promise((resolve, reject) => {
            $.ajax({
                url: '/Eventos/GenerarUrl',
                type: 'POST',
                data: {
                    p1: idActor,
                    p2: $("#subgrupo").val(),
                },
                success: function (data) {
                    $("#qrCode").empty();

                    $("#qrCode").kendoQRCode({
                        value: data,
                        size: 150,
                        color: "#000000",
                        background: "#ffffff"
                    });

                    $.ajax({
                        url: '/Actor/GetActorId',
                        type: 'GET',
                        data: { idActor: idActor },
                        success: async function (response) {
                            $("#lblActor").text(response.nombre + " " + response.apellidoPaterno + " " + response.apellidoMaterno);
                            $("#lblCArgoActual").text(response.cargoActual);
                            try {
                                const qrBase64 = await obtenerQrBase64();
                                $.ajax({
                                    url: '/Eventos/AddInvitacion',
                                    type: 'POST',
                                    data: {
                                        idDisposicion: idDisposicion,
                                        codigoQr: qrBase64
                                    },
                                    beforeSend: function () {
                                        mostrarLoading();
                                    },
                                    success: async function (result) {
                                        $("#hidIdInvitacion").val(result);
                                        $("#titleBoleto").text($("#hidEscenario").val());
                                        $("#lblLugar").html($("#hidLugar").val());
                                        if ($("#subgrupo").val() == 6 || $("#subgrupo").val() == 7) {
                                            $("#lblFila").text(" - ");
                                            $("#lblAsiento").text(" - ");
                                        } else {
                                            $("#lblFila").text(response.lugar);
                                            $("#lblAsiento").text(response.asiento);
                                        }
                                        $("#lblSeccion").text('');
                                        var detalleModal = $("#boletoModal").kendoWindow({
                                            title: "Boleto",
                                            visible: false,
                                            modal: true,
                                            width: "390px",
                                            height: "auto",
                                            actions: ["Close"]
                                        }).data("kendoWindow");
                                        detalleModal.center().open();

                                        // Retraso antes de descargar la imagen
                                        await descargarKendoWindowComoImagen("#boletoContent", response.asiento + response.lugar + ".png");
                                        $("#boletoModal").data("kendoWindow").close();
                                        resolve();
                                    },
                                    complete: function () {
                                        ocultarLoading();
                                    },
                                    error: function (error) {
                                        console.error('Error al asignar el actor:', error);
                                        reject(error); // ¡Promesa rechazada!
                                    }
                                });
                            } catch (error) {
                                console.error("Error al convertir el QR a Base64:", error);
                                reject(error); // ¡Promesa rechazada!
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error('Error al obtener los detalles del actor:', error);
                            reject(error); // ¡Promesa rechazada!
                        }
                    });
                },
                error: function (error) {
                    console.error('Error al asignar el actor:', error);
                    reject(error); // ¡Promesa rechazada!
                }
            });
        });
    }


    async function descargarKendoWindowComoImagen(selector, nombreArchivo) {
        try {
            // Retraso de 500 ms para asegurarte de que el contenido esté renderizado completamente
            await delay(500);

            kendo.drawing.drawDOM($(selector))
                .then(function (group) {
                    return kendo.drawing.exportImage(group);
                })
                .then(function (data) {
                    const a = document.createElement("a");
                    a.href = data;
                    a.download = nombreArchivo;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                })
                .catch(function (error) {
                    console.error("Error al descargar la imagen:", error);
                });
        } catch (error) {
            console.error("Error en descargarKendoWindowComoImagen:", error);
        }
    }
