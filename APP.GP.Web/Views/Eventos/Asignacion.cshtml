    // Funciones relacionadas con invitaciones
    function GenerarInvitacion(idActor, idDisposicion) {
        $("#detalleActorWindow").data("kendoWindow").close();
        if ($("#subgrupo").val() == 4) {
            $("#boletoContent").css("background-image", "url('/img/invite/SendelaI.jpg')");
            $("#divInfo").css({
                "margin-top": "300px",
                "color": "#FFF"
            });
            $("#lblUbicacionEsc").show();
            $("#divPrensa").hide();
        }
        else if ($("#subgrupo").val() == 5) {
            $("#boletoContent").css("background-image", "url('/img/invite/SendelaC.jpg')");
            $("#divInfo").css({
                "margin-top": "300px",
                "color": "#000"
            });
            $("#divPrensa").hide();
            $("#lblUbicacionEsc").show();
        } else if ($("#subgrupo").val() == 6 || $("#subgrupo").val() == 7) {
            $("#boletoContent").css("background-image", "url('/img/invite/prensa.jpg')");
            $("#divInfo").css({
                "margin-top": "300px",
                "color": "#000"
            });
            $("#lblUbicacionEsc").hide();
            $("#divPrensa").show();
        }
        $.ajax({
            url: '/Eventos/GenerarUrl',
            type: 'POST',
            data: {
                p1: idActor,
                p2: $("#subgrupo").val(),
            },
            success: function (data) {
                $("#qrCode").empty();

                $("#qrCode").kendoQRCode({
                    value: data,
                    size: 150,
                    color: "#000000",
                    background: "#ffffff"
                });

                $.ajax({
                    url: '/Actor/GetActorId',
                    type: 'GET',
                    data: { idActor: idActor },
                    success: async function (response) {
                        $("#lblActor").text(response.nombre + " " + response.apellidoPaterno + " " + response.apellidoMaterno);
                        //$("#lblCargoActuak").text(response.cargoActual);
                        $("#lblCArgoActual").text(response.cargoActual);
                        try {
                            const qrBase64 = await obtenerQrBase64();
                            $.ajax({
                                url: '/Eventos/AddInvitacion',
                                type: 'POST',
                                data: {
                                    idDisposicion: idDisposicion,
                                    codigoQr: qrBase64
                                },
                                beforeSend: function () {
                                    mostrarLoading();
                                },
                                success: function (result) {
                                    if (result > 0) {
                                        $("#hidIdInvitacion").val(result);
                                        $("#titleBoleto").text($("#hidEscenario").val());
                                        $("#lblLugar").html($("#hidLugar").val());
                                        if ($("#subgrupo").val() == 6 || $("#subgrupo").val() == 7) {
                                            $("#lblFila").text(" - ");
                                            $("#lblAsiento").text(" - ");
                                        } else {
                                            $("#lblFila").text(obtenerFilaSeleccionada());
                                            $("#lblAsiento").text(obtenerColumnaSeleccionada());
                                        }
                                        $("#lblSeccion").text(obtenerSeccionSeleccionada());
                                        var detalleModal = $("#boletoModal").kendoWindow({
                                            title: "Boleto",
                                            visible: false,
                                            modal: true,
                                            width: "390px",
                                            height: "auto",
                                            actions: ["Close"]
                                        }).data("kendoWindow");
                                        detalleModal.center().open();
                                    } else {
                                        MensajeExito("Error", "Error al generar la invitación: " + result.mensaje);
                                    }
                                },
                                complete: function () {
                                    ocultarLoading();
                                },
                                error: function (error) {
                                    console.error('Error al asignar el actor:', error);
                                }
                            });
                        } catch (error) {
                            console.error("Error al convertir el QR a Base64:", error);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('Error al obtener los detalles del actor:', error);
                    }
                });
            },
            error: function (error) {
                console.error('Error al asignar el actor:', error);
            }
        });
    }

    function cerratVentana() {
        $("#boletoModal").data("kendoWindow").close();
    }

    // Función para enviar correo
    function enviarCorreo() {
        $('#boletoModal').data('kendoWindow').close();
        mostrarLoading();

        // Capturar el contenido del KendoWindow en Base64
        capturarKendoWindowEnBase64("#boletoContent")
            .then((imagenBase64) => {
                const boletoHtml = `
                                                                <div style="text-align: center;">
                                                                    <h3>Invitación</h3>
                                                                    <img src="${imagenBase64}" alt="Vista previa de la invitación" style="max-width: 100%; border: 1px solid #ccc;" />
                                                                </div>
                                                            `;

                $.ajax({
                    url: '/Eventos/EnviarInvitacionCorreo',
                    type: 'POST',
                    data: {
                        idInvitacion: $("#hidIdInvitacion").val(),
                        cuerpo: boletoHtml,
                        imagen: imagenBase64
                    },
                    success: function (data) {
                        ocultarLoading();
                        if (data > 0) {
                            MensajeExito("Éxito", "La invitación ha sido enviada correctamente");
                        } else {
                            MensajeExito("Error", "Error al enviar el correo");
                        }
                    },
                    error: function (error) {
                        ocultarLoading();
                        console.error('Error al enviar el correo:', error);
                    }
                });
            })
            .catch((error) => {
                ocultarLoading();
                console.error("Error al capturar el contenido del KendoWindow en Base64:", error);
                MensajeExito("Error", "Error al generar la invitación.");
            });
    }

    // Eventos y document ready
    $(document).ready(function () {
        obtenerEventos();

        $(document).on("click", "div[id^='cuadro-'], .circle", function () {
            var selectedId = $(this).attr("id");
            if (selectedId) {
                $("#idSelected").val(selectedId);
                var actorId = $(this).data('actor-id');
                mostrarVentanaKendo("#windowInstitucional", "950px", "Búsqueda de invitados", actorId);
                if (!actorId)
                    obtenerAllActores();
            }
        });

        $("#exportarPDF").prepend('<i class="fas fa-file-pdf"></i>');
        $(".whatsapp-button").prepend('<i class="fab fa-whatsapp"></i>');
        $(".email-button").prepend('<i class="fas fa-envelope"></i>');

        $("#exportarPDF").click(function () {
            descargarKendoWindowComoImagen("#boletoContent", "boleto " + $("#lblActor").text() + ".png");
            // kendo.drawing.drawDOM("#boletoContent", {
            //     paperSize: "A5",
            //     margin: { top: ".5cm", bottom: "1cm", left: "1.5cm", right: "1.5cm" },
            //     scale: 0.8,
            //     landscape: false,
            // }).then(function (group) {
            //     kendo.drawing.pdf.saveAs(group, "boleto.pdf");
            // })
            //     .catch(function (error) {
            //         console.error("Error al generar el PDF:", error);
            //     });
        });
    });

    function capturarKendoWindowEnBase64(selector) {
        return kendo.drawing.drawDOM($(selector), {
            paperSize: "auto",
            margin: 0,
            scale: 1
        })
            .then(function (group) {
                return kendo.drawing.exportImage(group);
            })
            .catch(function (error) {
                console.error("Error al capturar el contenido del KendoWindow:", error);
                throw error;
            });
    }



    function descargarReporteExcel(event) {
        if (event) event.preventDefault();

        let idEscenario = $("#subgrupo").val();

        const url = `/Eventos/DescargarReporteExcel?idEscenario=${idEscenario}`;
        window.open(url, "_blank");
    }

    function obtenerIniciales(nombre, apellidoPaterno, apellidoMaterno = "") {
        let iniciales = "";

        if (nombre && nombre.length > 0) {
            iniciales += nombre.charAt(0);
        }

        if (apellidoPaterno && apellidoPaterno.length > 0) {
            iniciales += apellidoPaterno.charAt(0);
        }

        if (apellidoMaterno && apellidoMaterno.length > 0) {
            iniciales += apellidoMaterno.charAt(0);
        }

        return iniciales.toUpperCase();
    }

    function obtenerFilaSeleccionada() {
        var idSelected = $("#idSelected").val();
        var $selectedDiv = $("#" + idSelected);
        var fila = $selectedDiv.data("fila");
        return fila;
    }

    function obtenerColumnaSeleccionada() {
        var idSelected = $("#idSelected").val();
        var $selectedDiv = $("#" + idSelected);
        var columna = $selectedDiv.data("columna");
        return columna;
    }

    function obtenerSeccionSeleccionada() {
        var idSelected = $("#idSelected").val();
        var $selectedDiv = $("#" + idSelected);
        var parentSection = $selectedDiv.closest(".parent-container, .parent-container1, .parent-container2, .parent-container3, .parent-container4, .parent-container5");
        return parentSection.attr("id");
    }

    function obtenerQrBase64() {
        var qrCodeElement = $("#qrCode").getKendoQRCode();
        var svg = qrCodeElement.svg();
        var svgBlob = new Blob([svg], { type: "image/svg+xml;charset=utf-8" });

        return new Promise((resolve, reject) => {
            var url = URL.createObjectURL(svgBlob);
            var img = new Image();
            img.src = url;

            img.onload = function () {
                var canvas = document.createElement("canvas");
                canvas.width = img.width;
                canvas.height = img.height;

                var ctx = canvas.getContext("2d");
                ctx.drawImage(img, 0, 0);

                var base64Image = canvas.toDataURL("image/png");
                URL.revokeObjectURL(url);
                resolve(base64Image);
            };

            img.onerror = function (error) {
                URL.revokeObjectURL(url);
                reject(error);
            };
        });
    }
</script>


