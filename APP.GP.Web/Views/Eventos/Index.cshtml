    function GenerarInvitacion(idActor, idDisposicion) {
        $("#detalleActorWindow").data("kendoWindow").close();

        $("#boletoContent").css("background-image", "url('/img/invite/especial.jpg')");
        $("#divInfo").css({
            "margin-top": "185px",
            "color": "#FFF"
        });
        $("#lblUbicacionEsc").show();

        $.ajax({
            url: '/Eventos/GenerarUrl',
            type: 'POST',
            data: {
                p1: idActor,
                p2: $("#subgrupo").val(),
            },
            success: function (data) {
                $("#qrCode").empty();

                $("#qrCode").kendoQRCode({
                    value: data,
                    size: 100,
                    color: "#000000",
                    background: "#ffffff"
                });

                $.ajax({
                    url: '/Actor/GetActorId',
                    type: 'GET',
                    data: { idActor: idActor },
                    success: async function (response) {
                        $("#lblActor").text(response.nombre + " " + response.apellidoPaterno + " " + response.apellidoMaterno);

                        $("#lblCArgoActual").text(response.cargoActual);
                        try {
                            const qrBase64 = await obtenerQrBase64();
                            $.ajax({
                                url: '/Eventos/AddInvitacion',
                                type: 'POST',
                                data: {
                                    idDisposicion: idDisposicion,
                                    codigoQr: qrBase64
                                },
                                beforeSend: function () {
                                    mostrarLoading();
                                },
                                success: function (result) {
                                    if (result > 0) {
                                        $("#hidIdInvitacion").val(result);
                                        $("#titleBoleto").text($("#hidEscenario").val());
                                        $("#lblLugar").html($("#hidLugar").val());

                                        $("#lblFila").text(obtenerFilaSeleccionada());
                                        $("#lblAsiento").text(obtenerColumnaSeleccionada());

                                        $("#lblSeccion").text(obtenerSeccionSeleccionada());
                                        var detalleModal = $("#boletoModal").kendoWindow({
                                            title: "Boleto",
                                            visible: false,
                                            modal: true,
                                            width: "380px",
                                            height: "auto",
                                            actions: ["Close"]
                                        }).data("kendoWindow");
                                        detalleModal.center().open();
                                    } else {
                                        MensajeExito("Error", "Error al generar la invitación: " + result.mensaje);
                                    }
                                },
                                complete: function () {
                                    ocultarLoading();
                                },
                                error: function (error) {
                                    console.error('Error al asignar el actor:', error);
                                }
                            });
                        } catch (error) {
                            console.error("Error al convertir el QR a Base64:", error);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('Error al obtener los detalles del actor:', error);
                    }
                });
            },
            error: function (error) {
                console.error('Error al asignar el actor:', error);
            }
        });
    }

