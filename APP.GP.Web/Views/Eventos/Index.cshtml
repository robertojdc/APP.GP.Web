<div class="container-fluid py-4">
    <div class="card shadow-sm mb-4">
        <div class="card-header text-white text-center">
            <h3 class="mb-0">ADMINISTRACIÓN DE EVENTOS</h3>
        </div>
        <div class="card-body">
            <form id="clasificacionForm" class="row g-3">
                <div class="col-md-4">
                    <label for="ddlGrupo" class="form-label">EVENTO</label>
                    <input id="ddlGrupo" class="form-control" placeholder="Seleccione un grupo">
                </div>
                <div class="col-md-4">
                    <label for="subgrupo" class="form-label">ESCENARIO</label>
                    <input id="subgrupo" name="subgrupo" class="form-control" placeholder="Seleccione un subgrupo">
                </div>
                <input type="hidden" id="hidEvento" />
                <input type="hidden" id="hidEscenario" />
                <input type="hidden" id="hidFechaHora" />
            </form>
        </div>
    </div>
</div>

<input type="hidden" id="idSelected" />

<div id="divEscenario_1" style="display:none;"></div>
<div id="divEscenario_2" style="display:none;"></div>
<div id="divEscenario_3" style="display:none;"></div>
<input type="hidden" id="idActor">
<div id="windowInstitucional" style="border: 2px solid #8B0000; padding: 20px; background-color: #FFFFFF; display:none; min-height:500px;">
    <input id="actorAutoComplete" style="width: 100%;" />
    <div id="listView"></div>
</div>
<script type="text/x-kendo-template" id="template">
    <div class="actor" onclick="asignarActor(#= idActor #)">
        # if (fotoBase64) { #
            <img src="data:image/jpeg;base64,#= fotoBase64 #" alt="Foto de #= nombre # #= apellidoPaterno #" />
        # } else { #
            <img src="https://via.placeholder.com/110" alt="Foto no disponible" />
        # } #
        <h2>#: cargoActual #</h2>
        <h3>#: nombre # #: apellidoPaterno # #: apellidoMaterno #</h3>
    </div>
</script>
<div id="detalleActorWindow"></div>
<div id="boletoModal" style="display:none;">
    <div id="boletoContent">
        <div class="header">
            @* <img src="escudo_puebla.png" alt="Escudo de Puebla"> *@
            @*     <h1>PUEBLA</h1>
            <p>Gobierno del Estado 2024 - 2030</p> *@
        </div>
        <div class="content">
            <h3>TOMA DE PROTESTA</h3>
            <table id="tablaActor">
                <tr>
                    <td>NOMBRE</td>
                    <td><label id="lblActor"></label></td>
                </tr>
                <tr>
                    <td>CARGO</td>
                    <td><label id="lblCargo"></label></td>
                </tr>
                <tr>
                    <td>FECHA</td>
                    <td><label id="lblFecha"></label></td>
                </tr>
                <tr>
                    <td>HORA</td>
                    <td><label id="lblHora"></label></td>
                </tr>
                <tr>
                    <td>LUGAR</td>
                    <td><label id="lblLugar"></label></td>
                </tr>
                <tr>
                    <td>SECCIÓN</td>
                    <td><label id="lblSeccion"></label></td>
                </tr>
                <tr>
                    <td>FILA</td>
                    <td><label id="lblFila"></label></td>
                </tr>
                <tr>
                    <td>ASIENTO</td>
                    <td><label id="lblAsiento"></label></td>
                </tr>
            </table>
        </div>
        <div id="qrCode" class="qr-container"></div>
        <div class="footer">
            <p>© 2024 Gobierno del Estado de Puebla</p>
        </div>
    </div>
    <div class="row mb-3 buttons-container">
        <input type="button" id="exportarPDF" class="btn pdf-button styled-button" value="Descargar PDF" />
        <input type="button" class="btn whatsapp-button styled-button" value="Enviar a WhatsApp" onclick="enviarWhats()" />
        <input type="button" class="btn email-button styled-button" value="Enviar a Correo" onclick="$('#boletoModal').data('kendoWindow').close();" />
    </div>
</div>

<script>
    var allActors = [];
    $(document).ready(function () {
        obtenerAllActores();
        obtenerEventos();
        $(document).on("click", "div[id^='cuadro-'], .circle", function () {
            var selectedId = $(this).attr("id");
            if (selectedId) {
                $("#idSelected").val(selectedId);
                var actorId = $(this).data('actor-id');
                mostrarVentanaKendo("#windowInstitucional", "600px", "BÚsqueda de actores", actorId);
            }
        });

        $("#exportarPDF").prepend('<i class="fas fa-file-pdf"></i>');
        $(".whatsapp-button").prepend('<i class="fab fa-whatsapp"></i>');
        $(".email-button").prepend('<i class="fas fa-envelope"></i>');

        $("#exportarPDF").click(function () {
            kendo.drawing
                .drawDOM("#boletoContent", {
                    paperSize: "A4",
                    margin: { top: "2cm", bottom: "1cm", left: "3cm", right: "3cm" },
                    scale: 0.9,
                    height: 510,
                    landscape: false
                })
                .then(function (group) {
                    kendo.drawing.pdf.saveAs(group, "boleto.pdf");
                })
                .catch(function (error) {
                    console.error("Error al generar el PDF:", error);
                });
        });
    });

    function obtenerEventos() {
        $.ajax({
            url: '/Eventos/GetEventos',
            type: 'GET',
            success: function (response) {
                $("#ddlGrupo").kendoDropDownList({
                    dataTextField: "nombreEvento",
                    dataValueField: "idEvento",
                    dataSource: response,
                    optionLabel: "Seleccione un evento",
                    change: function (e) {
                        var idGrupo = this.value();
                        obtenerEscenarios(idGrupo);
                    }
                });
            },
            error: function (xhr, status, error) {
                console.log('Ocurrió un error: ' + error);
            }
        });
    }

    function obtenerEscenarios() {
        $.ajax({
            url: '/Eventos/GetEscenariosByEvento',
            type: 'GET',
            data: { idEvento: $("#ddlGrupo").val() },
            success: function (response) {
                $("#subgrupo").kendoDropDownList({
                    dataTextField: "nombreEscenario",
                    dataValueField: "idEscenario",
                    dataSource: response,
                    optionLabel: "Seleccione un escenario",
                    change: function (e) {
                        var idEscenario = this.value();
                        if (idEscenario == 1) {
                            $("#divEscenario_1").show();
                            $("#divEscenario_2").hide();
                            $("#divEscenario_2").empty();
                            $("#divEscenario_3").hide();
                            $("#divEscenario_3").empty();
                            $('#divEscenario_1').load('/escenarios/congreso.html', function (response, status, xhr) {
                                obtenerDisposicionesEscenario(idEscenario);
                            });
                        }
                        else if (idEscenario == 2) {
                            $("#divEscenario_1").hide();
                            $("#divEscenario_1").empty();
                            $("#divEscenario_2").show();
                            $("#divEscenario_3").hide();
                            $("#divEscenario_3").empty();
                            $('#divEscenario_2').load('/escenarios/vision.html', function (response, status, xhr) {
                                obtenerDisposicionesEscenario(idEscenario);
                            });
                        } else if (idEscenario == 3) {
                            $("#divEscenario_1").hide();
                            $("#divEscenario_1").empty();
                            $("#divEscenario_3").show();
                            $("#divEscenario_2").hide();
                            $("#divEscenario_2").empty();
                            $('#divEscenario_3').load('/escenarios/comida.html', function (response, status, xhr) {
                                obtenerDisposicionesEscenario(idEscenario);
                            });
                        }
                    }
                });
            },
            error: function (xhr, status, error) {
                console.log('Ocurrió un error: ' + error);
            }
        });
    }

    function obtenerDisposicionesEscenario(idEscenario) {
        obtenerDatosEscenariosById();
        $.ajax({
            url: '/Eventos/GetDisposicionesForEscenario',
            type: 'GET',
            data: { idEvento: $("#ddlgrupo").val(), idEscenario: idEscenario },
            success: function (data) {
                renderizarDisposiciones(data);
            },
            error: function (error) {
                console.error('Error al cargar las disposiciones:', error);
            }
        });
    }

    function renderizarDisposiciones(disposiciones) {
        $('div[data-fila][data-columna]').each(function () {
            $(this).css({
                "background-image": "",
                "background-size": "",
                "background-position": "",
                "background-repeat": ""
            });
            $(this).removeAttr('data-actor-id');
        });
        disposiciones.forEach(function (disposicion) {
            var fila = disposicion.fila;
            var columna = disposicion.columna;
            var idActor = disposicion.idActor;
            var fotoBase64 = disposicion.fotoBase64;

            var $cuadro = $('div[data-fila="' + fila + '"][data-columna="' + columna + '"]');

            if ($cuadro.length && idActor && fotoBase64) {
                $cuadro.css({
                    "background-image": "url('data:image/jpeg;base64," + fotoBase64 + "')",
                    "background-size": "cover",
                    "background-position": "center",
                    "background-repeat": "no-repeat"
                });
                $cuadro.attr('data-actor-id', idActor);
            }
        });
    }

    function obtenerDatosEscenariosById() {
        $.ajax({
            url: '/Eventos/GetEscenarioById',
            type: 'GET',
            data: { idEscenario: $("#subgrupo").val() },
            success: function (response) {
                console.log(response);
                $("#hidEvento").val(response.evento.nombreEvento);
                $("#hidEscenario").val(response.nombreEscenario);
                $("#hidFechaHora").val(response.evento.fechaEvento);
            },
            error: function (xhr, status, error) {
                console.log('Ocurrió un error: ' + error);
            }
        });
    }


    function obtenerAllActores() {
        if (allActors.length === 0) {
            $.ajax({
                url: '@Url.Action("GetAllActores", "Eventos")',
                type: 'GET',
                dataType: 'json',
                success: function (actors) {
                    allActors = actors.map(actor => ({
                        ...actor,
                        nombreCompleto: [
                            actor.nombre,
                            actor.apellidoPaterno,
                            actor.apellidoMaterno
                        ].filter(Boolean).join(' ')
                    }));
                    inicializarAutoComplete(allActors);
                },
                error: function (xhr, status, error) {
                    console.error('Error al obtener los actores:', error);
                }
            });
        }
    }

    function mostrarVentanaKendo(selector, ancho, titulo, id) {
        if (id) {
            verDetalleActor(id);
        } else {
            var listView = $("#listView").data("kendoListView");
            if (!listView) {
                console.log("Inicializando ListView...");
                $("#listView").kendoListView({
                    dataSource: [],
                    template: kendo.template($("#template").html())
                });
                console.log("ListView inicializado: ", $("#listView").data("kendoListView"));
                listView = $("#listView").data("kendoListView");
            }

            if (listView) {
                listView.dataSource.data([]);
            }

            var $kendoWindow = $(selector).kendoWindow({
                width: ancho,
                title: titulo,
                visible: false,
                modal: true,
                actions: ["Close"],
                close: function () {
                    $("#actorAutoComplete").val("");
                }
            }).data("kendoWindow");

            $kendoWindow.center().open();
        }
    }

    function inicializarAutoComplete(actors) {
        $("#actorAutoComplete").kendoAutoComplete({
            dataTextField: "nombreCompleto",
            placeholder: 'Por favor, seleccione un actor...',
            filter: "contains",
            dataSource: actors,
            suggest: true,
            template: function (dataItem) {
                let nombreCompleto = dataItem.nombreCompleto;
                let additionalInfo = [
                    dataItem.cargoActual,
                    dataItem.grupos,
                    dataItem.subGrupo,
                    dataItem.categoria
                ].filter(Boolean).join(' - ');

                return `${nombreCompleto} (${additionalInfo})`;
            },
            select: function (e) {
                var dataItem = this.dataItem(e.item.index());
                obtenerActor(dataItem.idActor);
            }
        });
    }

    $("#actorAutoComplete").on("input", function () {
        var searchText = $(this).val().toLowerCase();
        if (searchText.length >= 3) {
            filtrarActores(searchText);
        }
    });

    function filtrarActores(searchText) {
        var filteredActors = allActors.filter(function (actor) {
            let nombreCompleto = [
                actor.nombre,
                actor.apellidoPaterno,
                actor.apellidoMaterno
            ].filter(Boolean).join(" ").toLowerCase();

            let additionalInfo = [
                actor.cargoActual,
                actor.grupos,
                actor.subGrupo,
                actor.categoria
            ].filter(Boolean).join(" - ").toLowerCase();

            return nombreCompleto.includes(searchText) || additionalInfo.includes(searchText);
        });

        var autoComplete = $("#actorAutoComplete").data("kendoAutoComplete");
        if (autoComplete) {
            autoComplete.setDataSource(filteredActors);
        }
    }

    function obtenerActor(idActor) {
        $.ajax({
            url: '@Url.Action("GetActorById", "Eventos")',
            type: 'GET',
            data: { id: idActor },
            success: function (actor) {
                var listView = $("#listView").data("kendoListView");
                if (listView) listView.dataSource.data([actor]);
            },
            error: function (xhr, status, error) {
                console.error('Error al obtener el actor:', error);
            }
        });
    }

    function verDetalleActor(actorId) {
        var fila = obtenerFilaSeleccionada();
        var columna = obtenerColumnaSeleccionada();
        var seccion = obtenerSeccionSeleccionada();
        $.ajax({
            url: '@Url.Action("GetDetalleActor", "Actor")',
            type: 'GET',
            data: {
                id: actorId,
                seccion: seccion,
                fila: fila,
                asiento: columna,
                lugar: $("#hidEscenario").val(),
                hora: $("#hidFechaHora").val()
            },
            success: function (actor) {
                const detalleActorWindow = $("#detalleActorWindow").data("kendoWindow");

                if (!detalleActorWindow) {
                    $("#detalleActorWindow").kendoWindow({
                        width: "700px",
                        modal: true,
                        visible: false,
                        actions: ["Close"]
                    });
                }

                const windowInstance = $("#detalleActorWindow").data("kendoWindow");

                windowInstance.setOptions({
                    title: `${actor.cargoActual}`
                });
                const contenido = `
                                <div class="container mt-4 p-4 border rounded bg-light shadow-sm">
                                    <div class="row mb-4">
                                        <div class="col-12 col-md-4 text-center">
                                            <img src="data:image/png;base64,${actor.fotoBase64}" class="rounded-circle img-fluid mb-3" alt="Foto del actor político" style="width: 150px; height: 150px; object-fit: cover;">
                                        </div>
                                        <div class="col-12 col-md-8 d-flex align-items-center">
                                            <div>
                                                <h3 class="fw-bold">${actor.nombre} ${actor.apellidoPaterno} ${actor.apellidoMaterno}</h3>
                                                <p class="text-muted">Teléfono Personal: ${actor.telefonoPersonal}</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row gy-3">
                                        <div class="col-md-6">
                                            <label class="fw-semibold">Domicilio Laboral</label>
                                            <div class="text-secondary">${actor.domicilioLaboral}</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="fw-semibold">Teléfono Laboral</label>
                                            <div class="text-secondary">${actor.telefonoLaboral}</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="fw-semibold">Fecha de Nacimiento</label>
                                            <div class="text-secondary">${new Date(actor.fechaNacimiento).toLocaleDateString()}</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="fw-semibold">Correo Electrónico</label>
                                            <div class="text-secondary">${actor.correoElectronico}</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="fw-semibold">Redes Sociales</label>
                                            <div class="text-secondary">${actor.inputRedSocial ?? 'N/A'}</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="fw-semibold">Página Web</label>
                                            <div class="text-secondary">${actor.paginaWeb || 'N/A'}</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="fw-semibold">Afinidad</label>
                                            <div class="text-secondary">${actor.afinidad}</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="fw-semibold">Compromiso</label>
                                            <div class="text-secondary">${actor.compromiso}</div>
                                        </div>
                                        <div class="col-12">
                                            <label class="fw-semibold">Comentarios</label>
                                            <div class="text-secondary">${actor.comentarios}</div>
                                        </div>
                                    </div>

                                <div class="row">
                                <div class="col-2">  </div>
                                    <div class="col-4">
                                        <input type="button" class="btn btn-outline-secondary" onclick="GenerarInvitacion(${actor.idActor})" value="Generar invitación" id="btnInvite" />
                                    </div>
                                    <div class="col-4">
                                        <input type="button"class="btn btn-danger me-2" onclick="ModificarAsignacion(${actor.idActor})" value="Modificar Asignación" id="btnInvite" />
                                    </div>

                                </div>
                                     </div>
                            `;

                windowInstance.content(contenido);

                windowInstance.center().open();
            },
            error: function (xhr, status, error) {
                console.error('Error al obtener los detalles del actor:', error);
            }
        });
    }

