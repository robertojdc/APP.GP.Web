    function asignarActor(idActor) {
        var idDisposicion = $("#idSelected").val();
        var fila = obtenerFilaSeleccionada();
        var columna = obtenerColumnaSeleccionada();

        $.ajax({
            url: '/Eventos/AddDisposicion',
            type: 'POST',
            data: {
                IdActor: idActor,
                IdEscenario: $("#subgrupo").val(),
                IdDisposicion: idDisposicion,
                Fila: fila,
                Columna: columna
            },
            success: function (data) {
                MensajeExito("Éxito", "Lugar asignado satisfactoriamente");
                $("#subgrupo").data("kendoDropDownList").trigger("change");
                $("#windowInstitucional").data("kendoWindow").close();
                $("#detalleActorWindow").data("kendoWindow").close();
            },
            error: function (error) {
                console.error('Error al asignar el actor:', error);
            }
        });
    }

    function GenerarUrl() {
        $.ajax({
            url: '/Eventos/GenerarUrl',
            type: 'POST',
            data: {
                p1: idActor,
                p2: $("#subgrupo").val(),
            },
            success: function (data) {
                obtenerDisposicionesEscenario($("#subgrupo").val());
                $("#windowInstitucional").data("kendoWindow").close();
            },
            error: function (error) {
                console.error('Error al asignar el actor:', error);
            }
        });
    }

    function obtenerFilaSeleccionada() {
        var idSelected = $("#idSelected").val();
        var $selectedDiv = $("#" + idSelected);

        var fila = $selectedDiv.data("fila");

        return fila;
    }

    function obtenerColumnaSeleccionada() {
        var idSelected = $("#idSelected").val();
        var $selectedDiv = $("#" + idSelected);

        var columna = $selectedDiv.data("columna");

        return columna;
    }

    function obtenerSeccionSeleccionada() {
        var idSelected = $("#idSelected").val();
        var $selectedDiv = $("#" + idSelected);
        var parentSection = $selectedDiv.closest(".parent-container, .parent-container1, .parent-container2, .parent-container3, .parent-container4, .parent-container5");
        return parentSection.attr("id")?.replaceAll("_", " ");
    }

    function verificarAsignaciones() {
        const squares = document.querySelectorAll('.square');

        const errores = [];

        squares.forEach(square => {
            const fila = square.getAttribute('data-fila');
            const columna = square.getAttribute('data-columna');
            const id = square.id;

            const idEsperado = `cuadro-${fila}-${columna}`;

            if (id !== idEsperado) {
                errores.push({
                    elemento: square,
                    idActual: id,
                    idEsperado
                });
            }
        });

        if (errores.length > 0) {
            console.log('Se encontraron errores en los siguientes elementos:');
            errores.forEach(error => {
                console.log(`Elemento con id="${error.idActual}" debería ser "${error.idEsperado}"`);
            });
        } else {
            console.log('Todos los elementos tienen una correspondencia correcta.');
        }

    }
