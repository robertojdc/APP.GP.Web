<div class="container-fluid py-4">
    <div class="card shadow-sm mb-4">
        <div class="card-header text-white text-center">
            <h3 class="mb-0">ADMINISTRACIÓN DE EVENTOS</h3>
        </div>
        <div class="card-body">
            <form id="clasificacionForm" class="row g-3">
                <div class="col-md-4">
                    <label for="ddlGrupo" class="form-label">EVENTO</label>
                    <input id="ddlGrupo" class="form-control" placeholder="Seleccione un grupo">
                </div>
                <div class="col-md-4">
                    <label for="subgrupo" class="form-label">ESCENARIO</label>
                    <input id="subgrupo" name="subgrupo" class="form-control" placeholder="Seleccione un subgrupo">
                </div>
                <div class="col-md-4" id="btnDescargar" style="display:block; margin-top:48px;text-align:right;">
                    <input type="file" id="fileInvitados" />
                    <button type="button" class="btn btn-success" onclick="cargarInvitados()">Cargar</button> &nbsp;
                    <button type="button" class="btn btn-success" onclick="obtenerInvitados()">Descargar</button>
                </div>
                <input type="hidden" id="hidEvento" />
                <input type="hidden" id="hidEscenario" />
                <input type="hidden" id="hidFechaHora" />
                <input type="hidden" id="hidLugar" />
            </form>
        </div>
    </div>
</div>

<input type="hidden" id="idSelected" />

<div id="divEscenario_1" style="display:none;"></div>
<div id="divEscenario_2" style="display:none;"></div>
<div id="divEscenario_3" style="display:none;"></div>
<input type="hidden" id="idActor">
<div id="windowInstitucional" style="border: 2px solid #8B0000; padding: 20px; background-color: #FFFFFF; display:none; min-height:500px;">
    <input id="actorAutoComplete" style="width: 100%;" />
    <div id="listView"></div>
</div>
<script type="text/x-kendo-template" id="template">
    <div class="actor" onclick="asignarActor(#= idActor #)">
        # if (fotoBase64) { #
            <img src="data:image/jpeg;base64,#= fotoBase64 #" alt="Foto de #= nombre # #= apellidoPaterno #" />
        # } else { #
            <img src="https://via.placeholder.com/110" alt="Foto no disponible" />
        # } #
        <h2>#: cargoActual #</h2>
        <h3>#: nombre # #: apellidoPaterno # #: apellidoMaterno #</h3>
    </div>
</script>
<script id="templateTooltip" type="text/x-kendo-template">
    <div class="template-wrapper">
        <p>#=target.data('actor-id')#</p>
    </div>
</script>
<div id="detalleActorWindow"></div>
<div id="boletoModal" style="display:none;">
    <div id="boletoContent">
        <input type="hidden" id="hidIdInvitacion" />
        <div id="divInfo" style="text-align:center; font-size:13pt; width: 100%;">
            <p style="font-weight:500;">14 de diciembre de 2024</p>
            <p style="font-weight:500;">10:00 Horas</p>
            <label id="lblActor" style="font-weight:700; font-size:14pt; display:none;"></label>
            <div class="row" style="text-align:center;margin-top:19px;font-weight:500;">
                <div class="col-4">&nbsp;&nbsp;<label id="lblSeccion">A</label></div>
                <div class="col-4">&nbsp;<label id="lblFila">1</label></div>
                <div class="col-4"><label id="lblAsiento">1</label></div>
            </div>
        </div>
        <div id="qrCode" class="qr-container"></div>
    </div>
    <div class="row mb-3 buttons-container">
        <input type="button" id="exportarPDF" class="btn pdf-button styled-button" value="Descargar PDF" />
        <input type="button" class="btn whatsapp-button styled-button" value="Enviar a WhatsApp" onclick="enviarWhats()" />
        <input type="button" class="btn email-button styled-button" value="Enviar a Correo" onclick="enviarCorreo()" />
    </div>
</div>

<script>
    let disposicionesActor = [];

    function cargarInvitados(){
        //Funcion para enviar por ajax el input file al servidor
        var file = document.getElementById("fileInvitados").files[0];
        var formData = new FormData();
        formData.append("file", file);
        $.ajax({
            url: '/Eventos/CargarInvitados',
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            success: function (response) {
                console.log(response);
            },
            error: function (error) {
                console.error('Error al cargar los invitados:', error);
            }
        });
    }
    function enviarCorreo() {
        $('#boletoModal').data('kendoWindow').close();
        mostrarLoading();
        obtenerQrBase64().then((qrBase64) => {
            // Clonar el contenido actual del div para no modificar el DOM original
            const boletoContent = document.getElementById('boletoContent').cloneNode(true);

            // Reemplazar el contenido del div QR por una imagen en Base64
            const qrContainer = boletoContent.querySelector("#qrCode");

            if (qrContainer) {
                qrContainer.innerHTML = `
                                    <div style="display: flex; justify-content: center; align-items: center;">
                                        <div style="background-color: #FFF; padding: 10px; border-radius: 10px;">
                                            <img src="${qrBase64}" alt="Código QR" style="width: 300px; height: 150px; border: none;" />
                                        </div>
                                    </div>
                                `;
            }


            // Convertir el contenido actualizado a HTML
            const boletoHtml = boletoContent.innerHTML;

            // Enviar el correo con el HTML modificado
            $.ajax({
                url: '/Eventos/EnviarInvitacionCorreo',
                type: 'POST',
                data: { idInvitacion: $("#hidIdInvitacion").val(), cuerpo: boletoHtml },
                success: function (data) {
                    ocultarLoading();
                    if (data > 0) {-
                        MensajeExito("Éxito", "Correo enviado correctamente");
                    } else {
                        MensajeExito("Error", "Error al enviar el correo");
                    }
                },
                error: function (error) {
                    ocultarLoading();
                    console.error('Error al enviar el correo:', error);
                }
            });
        }).catch((error) => {
            console.error("Error al generar el QR en Base64:", error);
            MensajeExito("Error", "Error al generar el código QR.");
        });
    }
    var allActors = [];
    $(document).ready(function () {
        obtenerAllActores();
        obtenerEventos();
        $(document).on("click", "div[id^='cuadro-'], .circle", function () {
            var selectedId = $(this).attr("id");
            if (selectedId) {
                $("#idSelected").val(selectedId);
                var actorId = $(this).data('actor-id');
                mostrarVentanaKendo("#windowInstitucional", "600px", "Búsqueda de actores", actorId);
            }
        });

        $("#exportarPDF").prepend('<i class="fas fa-file-pdf"></i>');
        $(".whatsapp-button").prepend('<i class="fab fa-whatsapp"></i>');
        $(".email-button").prepend('<i class="fas fa-envelope"></i>');

        $("#exportarPDF").click(function () {
            descargarKendoWindowComoImagen("#boletoContent", "boleto " + $("#lblActor").text() + ".png");
        });


    });

    async function obtenerInvitados() {
        for (let i = 0; i < disposicionesActor.length; i++) {
            await GenerarInvitacionTest(disposicionesActor[i]);
            await delay(850);
        }
    }

    function GenerarInvitacionTest(response) {
        return new Promise((resolve, reject) => {
            $.ajax({
                url: '/Eventos/GenerarUrl',
                type: 'POST',
                data: {
                    p1: response.idActor,
                    p2: $("#subgrupo").val(),
                },
                success: async function (data) {

                    $("#boletoContent").css("background-image", "url('/img/invite/especial.jpg')");
                    $("#divInfo").css({
                        "margin-top": "185px",
                        "color": "#FFF"
                    });
                    $("#lblUbicacionEsc").show();

                    $("#qrCode").empty();

                    $("#qrCode").kendoQRCode({
                        value: data,
                        size: 100,
                        color: "#000000",
                        background: "#ffffff"
                    });
                    try {

                        $("#lblSeccion").text(response.zona);
                        $("#lblFila").text(response.fila);
                        $("#lblAsiento").text(response.columna);

                        var detalleModal = $("#boletoModal").kendoWindow({
                            title: "Boleto",
                            visible: false,
                            modal: true,
                            width: "390px",
                            height: "auto",
                            actions: ["Close"]
                        }).data("kendoWindow");
                        detalleModal.center().open();

                        // Retraso antes de descargar la imagen
                        await descargarKendoWindowComoImagen("#boletoContent", response.zona + '-' + response.fila + '-' + response.columna + ".png");
                        $("#boletoModal").data("kendoWindow").close();
                        resolve();


                    } catch (error) {
                        console.error("Error al convertir el QR a Base64:", error);
                        reject(error); // ¡Promesa rechazada!
                    }

                },
                error: function (error) {
                    console.error('Error al asignar el actor:', error);
                    reject(error); // ¡Promesa rechazada!
                }
            });
        });
    }

    async function invitacionesAutomaticas(idsUsuario) {
        for (const idUsuario of idsUsuario) {
            try {
                await GenerarInvitacionTest(idUsuario, $("#subgrupo").val());
                await delay(2000);
                break;
            } catch (error) {
                console.error(`Error procesando el usuario ${idUsuario}:`, error);
            }
        }
        console.log("Todas las invitaciones han sido generadas.");
    };

    function delay(ms) {
        return new Promise(resolve => setTimeout(resolve, ms));
    }

    async function descargarKendoWindowComoImagen(selector, nombreArchivo) {
        try {
            await delay(500);
            kendo.drawing.drawDOM($(selector))
                .then(function (group) {
                    return kendo.drawing.exportImage(group);
                })
                .then(function (data) {
                    const a = document.createElement("a");
                    a.href = data;
                    a.download = nombreArchivo;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                })
                .catch(function (error) {
                    console.error("Error al descargar la imagen:", error);
                });
        } catch (error) {
            console.error("Error en descargarKendoWindowComoImagen:", error);
        }
    }

    function obtenerQrBase64() {
        var qrCodeElement = $("#qrCode").getKendoQRCode();
        var svg = qrCodeElement.svg();
        var svgBlob = new Blob([svg], { type: "image/svg+xml;charset=utf-8" });

        return new Promise((resolve, reject) => {
            var url = URL.createObjectURL(svgBlob);
            var img = new Image();
            img.src = url;

            img.onload = function () {
                var canvas = document.createElement("canvas");
                canvas.width = img.width;
                canvas.height = img.height;

                var ctx = canvas.getContext("2d");
                ctx.drawImage(img, 0, 0);

                var base64Image = canvas.toDataURL("image/png");
                URL.revokeObjectURL(url);
                resolve(base64Image);
            };

            img.onerror = function (error) {
                URL.revokeObjectURL(url);
                reject(error);
            };
        });
    }

    function obtenerEventos() {
        $.ajax({
            url: '/Eventos/GetEventos',
            type: 'GET',
            success: function (response) {
                $("#ddlGrupo").kendoDropDownList({
                    dataTextField: "nombreEvento",
                    dataValueField: "idEvento",
                    dataSource: response,
                    optionLabel: "Seleccione un evento",
                    change: function (e) {
                        var idGrupo = this.value();
                        obtenerEscenarios(idGrupo);
                    }
                });
            },
            error: function (xhr, status, error) {
                console.log('Ocurrió un error: ' + error);
            }
        });
    }

    function obtenerEscenarios() {
        $.ajax({
            url: '/Eventos/GetEscenariosByEvento',
            type: 'GET',
            data: { idEvento: $("#ddlGrupo").val() },
            success: function (response) {
                $("#subgrupo").kendoDropDownList({
                    dataTextField: "nombreEscenario",
                    dataValueField: "idEscenario",
                    dataSource: response,
                    optionLabel: "Seleccione un escenario",
                    change: function (e) {
                        var idEscenario = this.value();
                        if (idEscenario == 1) {
                            $("#divEscenario_1").show();
                            $("#divEscenario_2").hide();
                            $("#divEscenario_2").empty();
                            $("#divEscenario_3").hide();
                            $("#divEscenario_3").empty();
                            $('#divEscenario_1').load('/escenarios/congreso.html?' + new Date().getTime(), function (response, status, xhr) {
                                obtenerDisposicionesEscenario(idEscenario);
                            });
                        }
                        else if (idEscenario == 2) {
                            $("#divEscenario_1").hide();
                            $("#divEscenario_1").empty();
                            $("#divEscenario_2").show();
                            $("#divEscenario_3").hide();
                            $("#divEscenario_3").empty();
                            $('#divEscenario_2').load('/escenarios/vision.html?' + new Date().getTime(), function (response, status, xhr) {
                                obtenerDisposicionesEscenario(idEscenario);
                            });
                        } else if (idEscenario == 3) {
                            $("#divEscenario_1").hide();
                            $("#divEscenario_1").empty();
                            $("#divEscenario_3").show();
                            $("#divEscenario_2").hide();
                            $("#divEscenario_2").empty();
                            $('#divEscenario_3').load('/escenarios/comida.html?' + new Date().getTime(), function (response, status, xhr) {
                                obtenerDisposicionesEscenario(idEscenario);
                            });
                        }
                    }
                });
            },
            error: function (xhr, status, error) {
                console.log('Ocurrió un error: ' + error);
            }
        });
    }

    function obtenerDisposicionesEscenario(idEscenario) {


        obtenerDatosEscenariosById();
        $.ajax({
            url: '/Eventos/GetDisposicionesForEscenario',
            type: 'GET',
            data: { idEvento: $("#ddlgrupo").val(), idEscenario: idEscenario, marcar: 1 },
            success: function (data) {
                disposicionesActor = data;
                renderizarDisposiciones(data);
            },
            error: function (error) {
                console.error('Error al cargar las disposiciones:', error);
            }
        });
    }

    function renderizarDisposiciones(disposiciones) {
        $("#btnDescargar").show();

        // Restablece todas las disposiciones
        $('div[data-fila][data-columna]').each(function () {
            $(this).css({
                "background-image": "",
                "background-size": "",
                "background-position": "",
                "background-repeat": "",
                "background-color": ""
            });
            $(this).removeAttr('data-actor-id');
        });

        // Asigna nuevas disposiciones
        disposiciones.forEach(function (disposicion) {
            var fila = disposicion.fila;
            var columna = disposicion.columna;
            var zona = disposicion.zona; // Nueva propiedad zona
            var idActor = disposicion.idActor;
            var fotoBase64 = disposicion.fotoBase64;

            // Encuentra el contenedor correcto por zona, fila y columna
            var $cuadro = $(`div[data-zona="${zona}"] div[data-fila="${fila}"][data-columna="${columna}"]`);

            if ($cuadro.length && idActor && fotoBase64) {
                // Asigna la imagen como fondo
                $cuadro.css({
                    "background-image": "url('data:image/jpeg;base64," + fotoBase64 + "')",
                    "background-size": "cover",
                    "background-position": "center",
                    "background-repeat": "no-repeat"
                });
                $cuadro.attr('data-actor-id', idActor);
            } else if ($cuadro.length) {
                // Si no hay foto, asigna un color de fondo por defecto
                $cuadro.css({
                    "background-color": "gray"
                });
            }
               $cuadro.kendoTooltip({
                    //content: kendo.template($("#templateTooltip").html()), // disposicion.nombreActor + ' ' + disposicion.apellidoPaterno + ' ' + disposicion.apellidoMaterno,
                    content: disposicion.nombreActor + '<br/>Lugar asignado: ' + zona + ' - ' + fila + ' - ' + columna,
                    position: "top",
                    animation: {
                        open: {
                            effects: "zoom",
                            duration: 50
                        }
                    }
                });
        });
    }


    function obtenerDatosEscenariosById() {
        $.ajax({
            url: '/Eventos/GetEscenarioById',
            type: 'GET',
            data: { idEscenario: $("#subgrupo").val() },
            success: function (response) {
                console.log(response);
                $("#hidEvento").val(response.evento.nombreEvento);
                $("#hidEscenario").val(response.nombreEscenario);
                $("#hidFechaHora").val(response.evento.fechaEvento);
                $("#hidLugar").val(response.descripcion);
            },
            error: function (xhr, status, error) {
                console.log('Ocurrió un error: ' + error);
            }
        });
    }


    function obtenerAllActores() {
        if (allActors.length === 0) {
            $.ajax({
                url: '@Url.Action("GetAllActores", "Eventos")',
                type: 'GET',
                dataType: 'json',
                success: function (actors) {
                    allActors = actors.map(actor => ({
                        ...actor,
                        nombreCompleto: [
                            actor.nombre,
                            actor.apellidoPaterno,
                            actor.apellidoMaterno
                        ].filter(Boolean).join(' ')
                    }));
                    inicializarAutoComplete(allActors);
                },
                error: function (xhr, status, error) {
                    console.error('Error al obtener los actores:', error);
                }
            });
        }
    }

    function mostrarVentanaKendo(selector, ancho, titulo, id) {
        if (id) {
            verDetalleActor(id);
        } else {
            var listView = $("#listView").data("kendoListView");
            if (!listView) {
                console.log("Inicializando ListView...");
                $("#listView").kendoListView({
                    dataSource: [],
                    template: kendo.template($("#template").html())
                });
                console.log("ListView inicializado: ", $("#listView").data("kendoListView"));
                listView = $("#listView").data("kendoListView");
            }

            if (listView) {
                listView.dataSource.data([]);
            }

            var $kendoWindow = $(selector).kendoWindow({
                width: ancho,
                title: titulo,
                visible: false,
                modal: true,
                actions: ["Close"],
                close: function () {
                    $("#actorAutoComplete").val("");
                }
            }).data("kendoWindow");

            $kendoWindow.center().open();
        }
    }

    function inicializarAutoComplete(actors) {
        $("#actorAutoComplete").kendoAutoComplete({
            dataTextField: "nombreCompleto",
            placeholder: 'Por favor, seleccione un actor...',
            filter: "contains",
            dataSource: actors,
            suggest: true,
            template: function (dataItem) {
                let nombreCompleto = dataItem.nombreCompleto;
                let additionalInfo = [
                    dataItem.cargoActual,
                    dataItem.grupos,
                    dataItem.subGrupo,
                    dataItem.categoria
                ].filter(Boolean).join(' - ');

                return `${nombreCompleto} (${additionalInfo})`;
            },
            select: function (e) {
                var dataItem = this.dataItem(e.item.index());
                obtenerActor(dataItem.idActor);
            }
        });
    }

    $("#actorAutoComplete").on("input", function () {
        var searchText = $(this).val().toLowerCase();
        if (searchText.length >= 3) {
            filtrarActores(searchText);
        }
    });

    function filtrarActores(searchText) {
        var filteredActors = allActors.filter(function (actor) {
            let nombreCompleto = [
                actor.nombre,
                actor.apellidoPaterno,
                actor.apellidoMaterno
            ].filter(Boolean).join(" ").toLowerCase();

            let additionalInfo = [
                actor.cargoActual,
                actor.grupos,
                actor.subGrupo,
                actor.categoria
            ].filter(Boolean).join(" - ").toLowerCase();

            return nombreCompleto.includes(searchText) || additionalInfo.includes(searchText);
        });

        var autoComplete = $("#actorAutoComplete").data("kendoAutoComplete");
        if (autoComplete) {
            autoComplete.setDataSource(filteredActors);
        }
    }

    function obtenerActor(idActor) {
        $.ajax({
            url: '@Url.Action("GetActorById", "Eventos")',
            type: 'GET',
            data: { id: idActor },
            success: function (actor) {
                var listView = $("#listView").data("kendoListView");
                if (listView) listView.dataSource.data([actor]);
            },
            error: function (xhr, status, error) {
                console.error('Error al obtener el actor:', error);
            }
        });
    }

    function verDetalleActor(actorId) {
