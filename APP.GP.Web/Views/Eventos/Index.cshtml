    function GenerarInvitacion(idActor) {
        $.ajax({
            url: '/Eventos/GenerarUrl',
            type: 'POST',
            data: {
                p1: idActor,
                p2: $("#subgrupo").val(),
            },
            success: function (data) {
                $("#qrCode").empty();

                $("#qrCode").kendoQRCode({
                    value: data,
                    size: 150,
                    color: "#000000",
                    background: "#ffffff"
                });

                $.ajax({
                    url: '@Url.Action("GetActorId", "Actor")',
                    type: 'GET',
                    data: { idActor: idActor },
                    success: function (response) {
                        $("#lblActor").text(response.nombre + " " + response.apellidoPaterno + " " + response.apellidoMaterno);
                        $("#lblCargo").text(response.cargo);

                        var fecha = new Date($("#hidFechaHora").val());

                        // Formatea la fecha larga
                        var fechaLarga = fecha.toLocaleDateString("es-MX", {
                            weekday: "long", // Día de la semana (ej. lunes)
                            year: "numeric", // Año completo
                            month: "long",   // Mes en texto largo (ej. enero)
                            day: "numeric"   // Día numérico
                        });

                        // Formatea la hora corta
                        var horaCorta = fecha.toLocaleTimeString("es-MX", {
                            hour: "2-digit",  // Hora en formato de 2 dígitos
                            minute: "2-digit" // Minutos en formato de 2 dígitos
                        });

                        // Asigna los valores formateados a los labels
                        $("#lblFecha").text(fechaLarga);
                        $("#lblHora").text(horaCorta);

                        $("#lblLugar").text($("#hidEscenario").val());
                        $("#lblFila").text(obtenerFilaSeleccionada());
                        $("#lblAsiento").text(obtenerColumnaSeleccionada());
                        $("#lblSeccion").text(obtenerSeccionSeleccionada());
                        var detalleModal = $("#boletoModal").kendoWindow({
                            title: "Boleto",
                            modal: true,
                            visible: false,
                            width: "500px",
                            height: "715px",
                            actions: ["Close"]
                        }).data("kendoWindow");
                        detalleModal.center().open();
                    },
                    error: function (xhr, status, error) {
                        console.error('Error al obtener los detalles del actor:', error);
                    }
                });
            },
            error: function (error) {
                console.error('Error al asignar el actor:', error);
            }
        });



    }

    function asignarActor(idActor) {
        var idDisposicion = $("#idSelected").val();
        var fila = obtenerFilaSeleccionada();
        var columna = obtenerColumnaSeleccionada();

        $.ajax({
            url: '/Eventos/AddDisposicion',
            type: 'POST',
            data: {
                IdActor: idActor,
                IdEscenario: $("#subgrupo").val(),
                IdDisposicion: idDisposicion,
                Fila: fila,
                Columna: columna
            },
            success: function (data) {
                obtenerDisposicionesEscenario($("#subgrupo").val());
                $("#windowInstitucional").data("kendoWindow").close();
                $("#detalleActorWindow").data("kendoWindow").close();
            },
            error: function (error) {
                console.error('Error al asignar el actor:', error);
            }
        });
    }

    function GenerarUrl() {
        $.ajax({
            url: '/Eventos/GenerarUrl',
            type: 'POST',
            data: {
                p1: idActor,
                p2: $("#subgrupo").val(),
            },
            success: function (data) {
                obtenerDisposicionesEscenario($("#subgrupo").val());
                $("#windowInstitucional").data("kendoWindow").close();
            },
            error: function (error) {
                console.error('Error al asignar el actor:', error);
            }
        });
    }

    function obtenerFilaSeleccionada() {
        var idSelected = $("#idSelected").val();
        var $selectedDiv = $("#" + idSelected);

        var fila = $selectedDiv.data("fila");

        return fila;
    }

    function obtenerColumnaSeleccionada() {
        var idSelected = $("#idSelected").val();
        var $selectedDiv = $("#" + idSelected);

        var columna = $selectedDiv.data("columna");

        return columna;
    }

    function obtenerSeccionSeleccionada() {
        var idSelected = $("#idSelected").val();
        var $selectedDiv = $("#" + idSelected);
        var parentSection = $selectedDiv.closest(".parent-container, .parent-container1, .parent-container2, .parent-container3, .parent-container4, .parent-container5");
        return parentSection.attr("id");
    }
</script>

<style>
    .parent-container {
        display: flex;
        justify-content: space-around;
        height: auto;
    }

        .parent-container .row {
            display: flex;
            justify-content: center;
            margin-bottom: 2px;
        }

            .parent-container .row div {
                text-align: center;
                padding: 8px;
                border: 1px solid #ccc;
                background-color: #f9f9f9;
                cursor: pointer;
                width: 30px;
                height: 30px;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 1px;
            }

    .parent-container1 {
        display: flex;
        justify-content: space-around;
        height: auto;
    }

        .parent-container1 .row {
            display: flex;
            justify-content: center;
            margin-bottom: 2px;
        }

            .parent-container1 .row div {
