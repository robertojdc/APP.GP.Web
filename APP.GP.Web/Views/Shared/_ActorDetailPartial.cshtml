@model APP.GP.Web.Model.Actor

@{
    Layout = null;
}

<div class="container mt-4 p-4 border rounded bg-light shadow-sm">
    <!-- Encabezado con la imagen del actor y nombre completo -->
    <div class="row mb-4">
        <div class="col-12 col-md-4 text-center">
            <img src="data:image/png;base64,@Model.FotoBase64" class="rounded-circle img-fluid mb-3" alt="Foto del actor político" style="width: 150px; height: 150px; object-fit: cover;">
        </div>
        <div class="col-12 col-md-8 d-flex align-items-center">
            <div>
                <h3 class="fw-bold">@Model.Nombre @Model.ApellidoPaterno @Model.ApellidoMaterno</h3>
                <p class="text-muted">Teléfono Personal @Model.TelefonoPersonal</p>
            </div>
        </div>
    </div>
    <div id="cargo" style="display: none;">@Model.CargoActual</div>
    <!-- Información de contacto y datos adicionales -->
    <div class="row gy-3">
        <div class="col-md-6">
            <label class="fw-semibold text-primary">Domicilio Laboral</label>
            <div class="text-secondary">@Model.DomicilioLaboral</div>
        </div>
        <div class="col-md-6">
            <label class="fw-semibold text-primary">Teléfono Laboral</label>
            <div class="text-secondary">@Model.TelefonoLaboral</div>
        </div>
        <div class="col-md-6">
            <label class="fw-semibold text-primary">Fecha de Nacimiento</label>
            <div class="text-secondary">@Model.FechaNacimiento?.ToString("dd/MM/yyyy")</div>
        </div>
        <div class="col-md-6">
            <label class="fw-semibold text-primary">Correo Electrónico</label>
            <div class="text-secondary">@Model.CorreoElectronico</div>
        </div>
        <div class="col-md-6">
            <label class="fw-semibold text-primary">Redes Sociales</label>
            <div class="text-secondary">@Model.inputRedSocial</div>
        </div>
        <div class="col-md-6">
            <label class="fw-semibold text-primary">Página Web</label>
            <div class="text-secondary">@Model.PaginaWeb</div>
        </div>
        <div class="col-md-6">
            <label class="fw-semibold text-primary">Afinidad</label>
            <div class="text-secondary">@Model.Afinidad</div>
        </div>
        <div class="col-md-6">
            <label class="fw-semibold text-primary">Compromiso</label>
            <div class="text-secondary">@Model.Compromiso</div>
        </div>
        <div class="col-12">
            <label class="fw-semibold text-primary">Comentarios</label>
            <div class="text-secondary">@Model.Comentarios</div>
        </div>
    </div>
    @if (Model != null && Model.Fila != null)
    {
        <div class="row gy-3">
            <input type="button" onclick="GenerarInvitacion(@Model.IdActor)" value="Generar invitación" id="btnInvite" />
        </div>
        <div id="boletoModal" style="display:none;">
            <div id="boletoContent">
                <div class="header">
                    @* <img src="escudo_puebla.png" alt="Escudo de Puebla"> *@
                    @*     <h1>PUEBLA</h1>
                <p>Gobierno del Estado 2024 - 2030</p> *@
                </div>
                <div class="content">
                    <h3>TOMA DE PROTESTA</h3>
                    <table id="tablaActor">
                        <tr>
                            <td>NOMBRE</td>
                            <td><label id="lblActor"></label></td>
                        </tr>
                        <tr>
                            <td>CARGO</td>
                            <td><label id="lblCargo"></label></td>
                        </tr>
                        <tr>
                            <td>FECHA</td>
                            <td><label id="lblFecha">@Model.FechaHora.Value.ToLongDateString()</label></td>
                        </tr>
                        <tr>
                            <td>HORA</td>
                            <td><label id="lblHora">@Model.FechaHora.Value.ToShortTimeString()</label></td>
                        </tr>
                        <tr>
                            <td>LUGAR</td>
                            <td><label id="lblLugar">@Model.Lugar</label></td>
                        </tr>
                        <tr>
                            <td>SECCIÓN</td>
                            <td><label id="lblSeccion">@Model.Seccion</label></td>
                        </tr>
                        <tr>
                            <td>FILA</td>
                            <td><label id="lblFila">@Model.Fila</label></td>
                        </tr>
                        <tr>
                            <td>ASIENTO</td>
                            <td><label id="lblAsiento">@Model.Asiento</label></td>
                        </tr>
                    </table>
                </div>
                <div id="qrCode" class="qr-container"></div>
                <div class="footer">
                    <p>© 2024 Gobierno del Estado de Puebla</p>
                </div>
            </div>
            <div class="row mb-3 buttons-container">
                <input type="button" id="exportarPDF" class="btn pdf-button styled-button" value="Descargar PDF" />
                <input type="button" class="btn whatsapp-button styled-button" value="Enviar a WhatsApp" onclick="enviarWhats()" />
                <input type="button" class="btn email-button styled-button" value="Enviar a Correo" onclick="$('#boletoModal').data('kendoWindow').close();" />
            </div>
        </div>
    }
</div>


<script>
    $(document).ready(function () {
        $("#exportarPDF").prepend('<i class="fas fa-file-pdf"></i>');
        $(".whatsapp-button").prepend('<i class="fab fa-whatsapp"></i>');
        $(".email-button").prepend('<i class="fas fa-envelope"></i>');

        $("#qrCode").kendoQRCode({
            value: "https://mi-sitio.com/invitacion",
            size: 150,
            color: "#000000",
            background: "#ffffff"
        });
        $("#exportarPDF").click(function () {
            console.log($("#boletoContent").html()); // Verifica el contenido
            kendo.drawing
                .drawDOM("#boletoContent", {
                    paperSize: "A4",
                    margin: { top: "2cm", bottom: "1cm", left: "3cm", right: "3cm" },
                    scale: 0.9,
                    height: 510,
                    landscape: false
                })
                .then(function (group) {
                    kendo.drawing.pdf.saveAs(group, "boleto.pdf");
                })
                .catch(function (error) {
                    console.error("Error al generar el PDF:", error);
                });
        });
    });

    function enviarWhats() {
        //Delay dummy y mensaje de confirmacion
        $('#boletoModal').data('kendoWindow').close();
        MensajeExito("Enviado", "Boleto enviado satisfactoriamente");
    }
    function GenerarInvitacion(idActor) {

        $.ajax({
            url: '@Url.Action("GetActorId", "Actor")',
            type: 'GET',
            data: { idActor: idActor },
            success: function (response) {
                $("#lblActor").text(response.nombre + " " + response.apellidoPaterno + " " + response.apellidoMaterno);
                $("#lblCargo").text(response.cargo);
                var detalleModal = $("#boletoModal").kendoWindow({
                    title: "Boleto",
                    modal: true,
                    visible: false,
                    width: "500px",
                    height: "715px",
                    actions: ["Close"]
                }).data("kendoWindow");
                detalleModal.center().open();
            },
            error: function (xhr, status, error) {
                console.error('Error al obtener los detalles del actor:', error);
            }
        });

    }
</script>

<style>
    #tablaActor {
        font-size: 12pt;
        border-collapse: collapse;
        width: 100%;
    }

        #tablaActor th, #tablaActor td {
            padding: 2px;
            text-align: left;
            border: none;
        }

        #tablaActor tr {
            background: none;
            color: inherit;
        }




    #boletoContent {
        width: 100%;
        margin: auto;
        background-color: #5b0e1d;
        border: 2px solid #5b0e1d;
        border-radius: 10px;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 15px;
        color: #fff;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    }

    .header img {
        width: 80px;
        margin-bottom: 10px;
    }

    .header h1 {
        font-size: 26px;
        margin: 5px 0;
    }

    .header p {
        font-size: 14px;
        margin: 0;
    }

    .content {
        width: 100%;
        text-align: left;
        margin: 10px 0;
    }

        .content p {
            margin: 5px 0;
            font-size: 16px;
        }

        .content h3 {
            text-align: center;
        }

    .qr-container {
        margin: 5px 0;
        text-align: center;
    }

    .footer {
        text-align: center;
        margin-top: 5px;
    }

        .footer p {
            font-size: 12px;
            color: #ccc;
        }

    .buttons-container {
        display: flex;
        justify-content: center;
        flex-wrap: nowrap; /* Cambiado a nowrap */
        gap: 10px;
        margin: auto;
        margin-top: 5px;
        overflow-x: auto; /* Permite desplazamiento horizontal si es necesario */
        width: 98%;
    }

    .styled-button {
        flex: 1 1 auto; /* Permite que los botones se ajusten */
        min-width: 100px; /* Ancho mínimo para los botones */
        padding: 10px 15px;
        border: none;
        border-radius: 5px;
        font-size: 14px;
        color: #fff;
        cursor: pointer;
        transition: background 0.3s ease, opacity 0.3s ease;
    }

    .pdf-button {
        background-color: #007bff;
    }

    .whatsapp-button {
        background-color: #25D366;
    }

    .email-button {
        background-color: #dc3545;
    }

    .styled-button:hover {
        opacity: 0.8;
    }

    @@media (max-width: 600px) {
        #boletoContent {
            padding: 15px;
        }

        .header h1 {
            font-size: 20px;
        }

        .content p {
            font-size: 14px;
        }

        .styled-button {
            font-size: 14px;
            padding: 8px 12px;
        }
    }

    .k-window-content {
        padding-inline: var(--kendo-spacing-1, 0.5rem);
    }
</style>