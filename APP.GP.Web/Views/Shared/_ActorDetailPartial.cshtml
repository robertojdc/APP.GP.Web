@model APP.GP.Web.Model.Actor

@{
    Layout = null;
}

<div class="container mt-4 p-4 border rounded bg-light shadow-sm">
    <!-- Encabezado con la imagen del actor y nombre completo -->
    <div class="row mb-4">
        <div class="col-12 col-md-4 text-center">
            <img src="data:image/png;base64,@Model.FotoBase64" class="rounded-circle img-fluid mb-3" alt="Foto del actor político" style="width: 150px; height: 150px; object-fit: cover;">
        </div>
        <div class="col-12 col-md-8 d-flex align-items-center">
            <div>
                <h3 class="fw-bold">@Model.Nombre @Model.ApellidoPaterno @Model.ApellidoMaterno</h3>
                <p class="text-muted">Teléfono Personal @Model.TelefonoPersonal</p>
            </div>
        </div>
    </div>
    <div id="cargo" style="display: none;">@Model.CargoActual</div>
    <!-- Información de contacto y datos adicionales -->
    <div class="row gy-3">
        <div class="col-md-6">
            <label class="fw-semibold text-primary">Domicilio Laboral</label>
            <div class="text-secondary">@Model.DomicilioLaboral</div>
        </div>
        <div class="col-md-6">
            <label class="fw-semibold text-primary">Teléfono Laboral</label>
            <div class="text-secondary">@Model.TelefonoLaboral</div>
        </div>
        <div class="col-md-6">
            <label class="fw-semibold text-primary">Fecha de Nacimiento</label>
            <div class="text-secondary">@Model.FechaNacimiento?.ToString("dd/MM/yyyy")</div>
        </div>
        <div class="col-md-6">
            <label class="fw-semibold text-primary">Correo Electrónico</label>
            <div class="text-secondary">@Model.CorreoElectronico</div>
        </div>
        <div class="col-md-6">
            <label class="fw-semibold text-primary">Redes Sociales</label>
            <div class="text-secondary">@Model.inputRedSocial</div>
        </div>
        <div class="col-md-6">
            <label class="fw-semibold text-primary">Página Web</label>
            <div class="text-secondary">@Model.PaginaWeb</div>
        </div>
        <div class="col-md-6">
            <label class="fw-semibold text-primary">Afinidad</label>
            <div class="text-secondary">@Model.Afinidad</div>
        </div>
        <div class="col-md-6">
            <label class="fw-semibold text-primary">Compromiso</label>
            <div class="text-secondary">@Model.Compromiso</div>
        </div>
        <div class="col-12">
            <label class="fw-semibold text-primary">Comentarios</label>
            <div class="text-secondary">@Model.Comentarios</div>
        </div>
    </div>
</div>
