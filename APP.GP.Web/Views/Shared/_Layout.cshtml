<!DOCTYPE html>
<html class=" js " lang="es">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <title>Gobierno del Estado de Puebla</title>
    <link rel="icon" type="image/png" sizes="32x32" href="~/img/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="~/img/favicon/favicon-16x16.png">
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="~/js/popper.min.js"></script>
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <link href="~/lib/kendo/styles/material-arctic.css" rel="stylesheet" />
    <link href="~/css/kendoicons.css" rel="stylesheet" />
    <link href="~/css/jquery-ui.css" rel="stylesheet" />
    <link href="~/css/app/home.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body cz-shortcut-listen="true">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-light">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    @if (User.FindFirst(System.Security.Claims.ClaimTypes.Sid)?.Value == "1")
                    {
                        <li class="nav-item">
                            <a class="nav-link active" aria-current="page" href="#">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a href="../Home/Tablero" title="Tablero de actores" class="nav-link">Tablero de actores</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="administracionDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Administración
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="administracionDropdown">
                                <li><a class="dropdown-item" href="../Actor/Select">Actores</a></li>
                                <li><a class="dropdown-item" href="../Grupo/Index">Grupo</a></li>
                                <li><a class="dropdown-item" href="../SubGrupo/Index">Subgrupo</a></li>
                                <li><a class="dropdown-item" href="../Categoria/Index">Categoría</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="invitacionDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Invitación
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="invitacionDropdown">
                                <li><a class="dropdown-item" href="../Invitacion/Relation">Relacionar Invitados</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a href="../Eventos/Index" title="Eventos" class="nav-link">Eventos</a>
                        </li>

                    }
                    else
                    {
                        <li class="nav-item">
                            <a href="../Actor/Select" title="Invitados" class="nav-link">Invitados</a>
                        </li>
                        <li class="nav-item">
                            <a href="../Eventos/Asignacion" title="Eventos" class="nav-link">Eventos</a>
                        </li>
                    }
                    <li class="nav-item">
                        @Html.ActionLink("Cerrar sesión", "Logout", "Usuario", null, new { @class = "nav-link" })
                    </li>
                </ul>
            </div>
        </nav>
    </header>
    <div class="container nav-header-container">
        <div class="col-auto header-content">
            <a href="#" title="Consejo Nacional Morena" class="logo"></a>
        </div>
    </div>
    <script src="~/js/app/layout.js?v=1.0.1"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/kendo/js/kendo.all.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/js/jquery-ui.min.js"></script>
    <div class="container-fluid">
        @RenderBody()
    </div>
    <div id="modalLoading" class="divLoad" style="display:none;">
        <div class="spinner-border text-danger centerLoading" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
    <style>
        /* Mantener elementos en una sola fila */
        @@media (max-width: 768px) {
            .nav-header-container .col-auto {
                margin-bottom: 15px;
                width: 100%;
            }

            z
            .accordion-menu {
                display: flex;
                flex-wrap: wrap;
                justify-content: center;
            }

            .nav-header-container .navbar-nav {
                display: flex;
                flex-wrap: wrap;
            }

                .nav-header-container .navbar-nav li {
                    margin-bottom: 10px;
                    flex: 1 1 45%; /* Ocupa 45% del ancho disponible */
                    text-align: center;
                }
        }

        .swal-zindex-override {
            z-index: 20000 !important; /* Asegúrate de que sea mayor al z-index de Kendo Window */
        }
    </style>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
