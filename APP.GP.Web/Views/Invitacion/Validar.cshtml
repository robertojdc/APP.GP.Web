@{
    ViewData["Title"] = "Validar Invitación";
    Layout = null;
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: 100vh; font-size: 150%;">
    @if (Model.Acceso)
    {
        <div class="card shadow-sm w-100" style="max-width: 600px;">
            <div class="card-header text-bg-dark text-center p-4">
                <h3 class="mb-4">INVITACIÓN YA INGRESADA</h3>
                <h3 class="fw-bold">@Model.Nombre @Model.ApellidoPaterno @Model.ApellidoMaterno</h3>
                <h4 class="text-bg-dark mb-3">@Model.CargoActual</h4>

                <div class="table-responsive">
                    <table class="table table-borderless">
                        <tbody>
                            <tr>
                                <th class="text-end">Evento:</th>
                                <td>@Model.NombreEvento</td>
                            </tr>
                            <tr>
                                <th class="text-end">Descripción del Evento:</th>
                                <td>@Model.DescripcionEvento</td>
                            </tr>
                            <tr>
                                <th class="text-end">Fecha del Evento:</th>
                                <td>@Model.FechaEvento.ToString("dd/MM/yyyy HH:mm") hrs</td>
                            </tr>
                            <tr>
                                <th class="text-end">Zona:</th>
                                <td>@Model.Zona</td>
                            </tr>
                            <tr>
                                <th class="text-end">Fila:</th>
                                <td>@Model.Fila</td>
                            </tr>
                            <tr>
                                <th class="text-end">Asiento:</th>
                                <td>@Model.Columna</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="alert alert-danger mt-4 fw-bold">
                    La invitación ya fue escaneada el @Model.FechaAcceso.ToString("dd/MM/yyyy HH:mm") hrs
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm w-100" style="max-width: 600px;">
            <div class="card-header text-center p-4" style="background-color:#79211F; color: #FFF">
                <h3 class="mb-4">INVITACIÓN VÁLIDA</h3>
                <h3 class="fw-bold">@Model.Nombre @Model.ApellidoPaterno @Model.ApellidoMaterno</h3>
                <h4 class="mb-3">@Model.CargoActual</h4>

                <div class="table-responsive">
                    <table class="table table-borderless">
                        <tbody>
                            <tr>
                                <th class="text-end">Evento:</th>
                                <td>@Model.NombreEvento</td>
                            </tr>
                            <tr>
                                <th class="text-end">Descripción del Evento:</th>
                                <td>@Model.DescripcionEvento</td>
                            </tr>
                            <tr>
                                <th class="text-end">Fecha del Evento:</th>
                                <td>@Model.FechaEvento.ToString("dd/MM/yyyy HH:mm") hrs</td>
                            </tr>
                            <tr>
                                <th class="text-end">Zona:</th>
                                <td style="text-align:center; font-weight:800;"><b>@Model.Zona</b></td>
                            </tr>
                            <tr>
                                <th class="text-end">Fila:</th>
                                <td style="text-align:center; font-weight:800;"><b>@Model.Fila</b></td>
                            </tr>
                            <tr>
                                <th class="text-end">Asiento:</th>
                                <td style="text-align:center; font-weight:800;"><b>@Model.Columna</b></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="alert alert-success mt-4 fw-bold">
                    Acceso correcto
                </div>
            </div>
        </div>
    }
</div>

<link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="~/css/app/home.css" rel="stylesheet" />